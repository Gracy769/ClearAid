{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invoice-ready",
  "main": "dist/cloudflare-worker/bundle/index.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "dist/cloudflare-worker/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "observability": {
    "enabled": true
  },
  // Workers AI binding for edge LLM inference
  "ai": {
    "binding": "AI"
  },
  // Non-sensitive runtime environment variables
  "vars": {
    "PAYPAL_SANDBOX": "true",
    "PAYPAL_API_BASE_URL": "https://api-m.sandbox.paypal.com",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "APP_URL": "https://invoice-ready.graceperez769.workers.dev"
  },
  // Required secrets validated by Wrangler during deployment and local dev
  "secrets": {
    "required": [
      "DATABASE_URL",
      "APP_SECRET",
      "PAYPAL_CLIENT_ID",
      "PAYPAL_CLIENT_SECRET",
      "GEMINI_API_KEY",
      "ADMIN_TOKEN"
    ]
  }
}
