{
  "info": {
    "_postman_id": "302f7b70-e2d9-4e7d-a8c6-3a4a01e26ff8",
    "name": "ClearAid API Health",
    "description": "Read-only smoke check for the deployed ClearAid status endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public API health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/status",
        "description": "Read-only health/configuration status. No credentials or writes are required."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns JSON', function () { pm.response.to.be.json; });",
              "const status = pm.response.json();",
              "pm.test('reports PayPal Sandbox mode', function () { pm.expect(status.sandbox).to.eql(true); });",
              "pm.test('Neon database is connected', function () { pm.expect(status.databaseConnected).to.eql(true); });",
              "pm.test('service configuration fields are booleans', function () {",
              "  ['paypalConfigured', 'webhookConfigured', 'geminiConfigured', 'databaseConfigured'].forEach(function (key) {",
              "    pm.expect(status[key]).to.be.a('boolean');",
              "  });",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://invoice-ready.graceperez769.workers.dev",
      "type": "string"
    }
  ]
}
